datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  images      String[] // Ein Array von URLs für die moderne Bildergalerie
  category    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sellerId    String?  // Später wichtig für das Seller-Dashboard
}