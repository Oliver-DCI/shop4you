datasource db {
  provider = "postgresql"
  // url entfällt hier komplett!
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"] // Aktiviert den modernen Adapter-Modus
}

model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  images      String[]
  category    String
  stock       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sellerId    String?
}